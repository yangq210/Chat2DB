<Window x:Class="SwitchNet.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwitchNet Settings"
        Height="520" Width="640"
        MinHeight="400" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F5">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Open config file" Padding="12,6" Margin="0,0,8,0" Click="OpenConfig_Click"/>
      <Button Content="Save" Padding="16,6" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
      <Button Content="Close" Padding="16,6" IsCancel="True" Click="Close_Click"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="SwitchNet" FontSize="22" FontWeight="SemiBold" Foreground="#0F3D2E"/>
        <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Foreground="#334"
                   Text="Edit Wi‑Fi SSIDs, LAN subnets, and gateways. Placeholders must be replaced with your company values before use."/>

        <CheckBox x:Name="AutoSwitchCheck" Content="Auto-apply routes when SSID changes" Margin="0,0,0,8"/>
        <DockPanel Margin="0,0,0,12">
          <TextBlock Text="Wi‑Fi interface name:" VerticalAlignment="Center" Width="150"/>
          <TextBox x:Name="InterfaceNameBox" Padding="6,4"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,16">
          <TextBlock Text="SSID poll interval (s):" VerticalAlignment="Center" Width="150"/>
          <TextBox x:Name="PollIntervalBox" Padding="6,4" Width="80" HorizontalAlignment="Left"/>
        </DockPanel>

        <TextBlock Text="Profiles" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ItemsControl x:Name="ProfilesHost"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
