<Window x:Class="SwitchNet.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwitchNet Settings"
        Height="560" Width="640"
        MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F5">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Open config file" Padding="12,6" Margin="0,0,8,0" Click="OpenConfig_Click"/>
      <Button Content="Save" Padding="16,6" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
      <Button Content="Close" Padding="16,6" IsCancel="True" Click="Close_Click"/>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="SwitchNet" FontSize="22" FontWeight="SemiBold" Foreground="#0F3D2E"/>
        <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Foreground="#334"
                   Text="Everyday default is 默认有线 (Ethernet). GitLab / CRM temporarily prefer USB Wi‑Fi. Paste Ethernet ipconfig when known."/>

        <CheckBox x:Name="AutoSwitchCheck" Content="Auto-apply Wi‑Fi profile when SSID changes (off = tray-only; recommended)" Margin="0,0,0,8"/>
        <CheckBox x:Name="PreferWifiCheck" Content="While on GitLab/CRM: prefer USB Wi‑Fi over Ethernet" Margin="0,0,0,8"/>
        <CheckBox x:Name="DisconnectWifiCheck" Content="On 默认有线: disconnect USB Wi‑Fi" Margin="0,0,0,8"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#556"
                   Text="USB adapter only (MERCURY Wireless N). Set name from: netsh interface show interface"/>
        <DockPanel Margin="0,0,0,12">
          <TextBlock Text="USB Wi‑Fi interface:" VerticalAlignment="Center" Width="150"/>
          <TextBox x:Name="InterfaceNameBox" Padding="6,4"/>
        </DockPanel>
        <DockPanel Margin="0,0,0,16">
          <TextBlock Text="SSID poll interval (s):" VerticalAlignment="Center" Width="150"/>
          <TextBox x:Name="PollIntervalBox" Padding="6,4" Width="80" HorizontalAlignment="Left"/>
        </DockPanel>

        <TextBlock Text="Profiles" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ItemsControl x:Name="ProfilesHost"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
